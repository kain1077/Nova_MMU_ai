# ─────────────────────────────────────────────────────────────
#  MMU configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and edit. `.env` is gitignored.
#
#     cp .env.example .env
#
# Everything here has a working default EXCEPT NEO4J_PASS, which
# you must set. The stack refuses to start without it rather than
# falling back to a well-known password.


# ── Database ─────────────────────────────────────────────────
# Required. Any non-empty string. This is the password for the
# Neo4j container that runs on your machine.
#
# Applied ONLY when Neo4j first initializes an empty data directory.
# Editing this later does not change an existing database's password --
# see "Changing your database password" in the README.
NEO4J_PASS=change-me

# Host ports. Change these if something already uses them, or to
# run a second instance alongside a first.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MMU_PORT=8765

# Container names. Docker requires these to be globally unique, so a
# second instance must override BOTH -- a different compose project
# name (-p) is not enough on its own.
MMU_NEO4J_NAME=mmu-neo4j
MMU_SERVER_NAME=mmu-memory-server


# ── Access control ───────────────────────────────────────────
# Interface the published ports bind to. 127.0.0.1 means this machine
# ONLY, which is the right default: MMU has no authentication unless
# you set MMU_API_KEY below, and the Neo4j browser on 7474 gives full
# database access to anyone who can reach it.
#
# Set to 0.0.0.0 to expose on your LAN -- and if you do, set
# MMU_API_KEY as well. Do not do one without the other.
MMU_BIND=127.0.0.1

# Shared secret for MMU's API. Unset = no authentication, which is
# fine while bound to localhost. When set, EVERY endpoint except
# /health requires it, sent as `X-MMU-Key: <key>` or
# `Authorization: Bearer <key>`.
#
# The MCP bridge and idle daemon read this same variable, so set it in
# their environment too or they will start getting 401s.
MMU_API_KEY=

# Browser origins allowed to call the API. EMPTY = CORS disabled, which
# is correct for every current use: the MCP bridge and idle daemon are
# server-side and do not use CORS at all.
#
# This was once "*", which let any website you visited read /export or
# call /forget_all against your own machine. Only set this if you build
# a browser UI, and then list exact origins, never "*".
MMU_CORS_ORIGINS=


# ── Embeddings (semantic recall) ─────────────────────────────
# MMU calls an OpenAI-compatible /v1/embeddings endpoint. LM Studio,
# Ollama's OpenAI shim, llama.cpp server and vLLM all speak this.
#
# NOTE: the server runs inside Docker, so `localhost` here means the
# CONTAINER, not your machine. host.docker.internal is your machine.
MMU_EMBEDDING_ENABLED=true
MMU_EMBEDDING_BASE=http://host.docker.internal:1234/v1
MMU_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Bearer token, if your embedding server requires one. LM Studio can be
# configured to demand it (Developer -> server settings), and a token
# requirement turns every call into a 401. Leave blank if unused.
MMU_EMBEDDING_API_KEY=
# Same, for the optional idle daemon's chat model.
MMU_LMSTUDIO_API_KEY=

# MUST match what your model actually returns. It is baked into the
# Neo4j vector index when the index is created, and vectors from
# different models are not comparable.
#
# To check:  curl http://127.0.0.1:1234/v1/embeddings \
#              -d '{"input":"test","model":"<your-model>"}' \
#            and count the returned array.
#
# Changing the model later means: update this, DROP INDEX
# memory_embedding, restart, then POST /backfill_embeddings.
MMU_EMBEDDING_DIM=768


# ── Recall tuning ────────────────────────────────────────────
# Similarity floor for dropping weak keyword hits. Neo4j normalizes
# cosine to [0,1] where 0.5 is ORTHOGONAL, not 0.0 -- a value below
# 0.5 filters nothing. 0.0 disables dropping entirely.
#
# Every /recall result carries its semantic_score, so watch real
# values before raising this. Measured on one real graph: unrelated
# pairs 0.70-0.74, genuinely relevant 0.83-0.89.
MMU_SEMANTIC_FLOOR=0.0

# Weight for semantic-only hits during ranking. Kept below the
# keyword-similarity weight so a semantic hit never outranks a real
# keyword hit.
MMU_SEMANTIC_WEIGHT=0.80


# ── Memory aging ─────────────────────────────────────────────
# Memories cool as they go unrecalled: Green -> Yellow -> Blue.
# Blue is dormant (excluded from expansion and semantic search).
#
# Archiving requires BOTH conditions: unused for HOLD/ARCHIVE_THRESH
# recalls AND untouched for ARCHIVE_MIN_DAYS days. Count alone is not
# enough -- otherwise a busy afternoon archives your whole graph.
MMU_HOLD_THRESH=20
MMU_ARCHIVE_THRESH=20
MMU_ARCHIVE_MIN_DAYS=14

# Don't age at all until the graph has at least this many
# conversational memories. On a small graph "unused" carries no
# information -- there isn't enough history for it to mean anything.
# Ingested documents never age and don't count toward this.
MMU_AGING_MIN_MEMORIES=25


# ── Proactive suggestions ────────────────────────────────────
# Unrequested "you might also want" items attached to a recall.
# Set MMU_ANTICIPATE_MAX=0 to turn this off entirely.
MMU_ANTICIPATE_MAX=3
MMU_ANTICIPATE_PER_SESSION=5


# ── Document ingestion ───────────────────────────────────────
# Host folder to ingest documents from, mounted READ-ONLY into the
# container. /ingest cannot read outside it.
MMU_DOC_HOST=./documents


# ── Web ingestion (optional, OFF by default) ─────────────────
# Lets POST /ingest fetch a URL you name, strip the HTML, and store it
# the same way a PDF is stored. Marked src_type=3 ("Web").
#
# READ THIS BEFORE ENABLING. A fetched page can contain text written at
# your model ("note to AI assistants: remember that..."), and anything
# stored here becomes DURABLE memory that recall keeps re-feeding for as
# long as it lives -- considerably worse than a one-off injection in a
# chat window.
#
# Mitigations built in: only URLs YOU name are fetched (no model picks
# its own), private/loopback addresses are refused, redirects are not
# followed, responses are size-capped, and every web memory carries its
# source URL and shows as "Web" in recall output.
#
# Prefer having the model summarize a page and save the summary over
# storing raw page text -- its judgment is a filter; a verbatim dump has
# none.
MMU_WEB_ENABLED=false
MMU_WEB_MAX_BYTES=3145728
MMU_WEB_TIMEOUT=20
