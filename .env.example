# MMU — Modular Memory Unit
# ---------------------------------------------------------------------------
# Copy this file to .env and edit. Every value below is the default that
# docker-compose.yml already falls back to, so an .env with only NEO4J_PASS set
# is a working configuration.
#
#   cp .env.example .env
#
# Settings that are hardcoded in docker-compose.yml (NEO4J_URI, NEO4J_USER,
# MMU_DOC_ROOT, MMU_INDEX_PATH) are deliberately absent — they are not meant to
# be overridden from here.


# ── Required ───────────────────────────────────────────────────────────────
# Database password. There is no default; the stack refuses to start without it.
NEO4J_PASS=


# ── Embeddings ─────────────────────────────────────────────────────────────
# An OpenAI-compatible /v1/embeddings endpoint. LM Studio, Ollama's OpenAI shim,
# llama.cpp's server and vLLM all work.
#
# NOTE: the server runs inside Docker, so LM Studio is NOT on localhost from its
# point of view. host.docker.internal is the host machine.
MMU_EMBEDDING_ENABLED=true
MMU_EMBEDDING_BASE=http://host.docker.internal:1234/v1
MMU_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Must match what your model actually returns. It is baked into the Neo4j vector
# index at creation time, so changing the model means changing this AND
# dropping/recreating the memory_embedding index. nomic-embed-text-v1.5 = 768.
MMU_EMBEDDING_DIM=768

# Only needed if your embeddings endpoint requires auth. Leave empty for LM Studio.
MMU_EMBEDDING_API_KEY=


# ── Recall tuning ──────────────────────────────────────────────────────────
# Neo4j normalizes cosine similarity to [0,1] where 0.5 = orthogonal. 0.0
# disables down-ranking entirely, so the keyword path cannot regress. Raise this
# only after reading real semantic_score values out of /recall.
MMU_SEMANTIC_FLOOR=0.0

# How much a semantic match counts relative to a keyword match.
MMU_SEMANTIC_WEIGHT=0.80

# Proactive "you might also want" suggestions. 0 disables them.
MMU_ANTICIPATE_MAX=3
MMU_ANTICIPATE_PER_SESSION=5


# ── Memory aging ───────────────────────────────────────────────────────────
# Don't age at all below this many memories.
MMU_AGING_MIN_MEMORIES=25

# Days untouched before a memory is eligible to archive. Archiving needs both
# sustained disuse and real elapsed time, so a busy afternoon can't wipe your
# working set.
MMU_ARCHIVE_MIN_DAYS=14

MMU_HOLD_THRESH=20
MMU_ARCHIVE_THRESH=20


# ── Network ────────────────────────────────────────────────────────────────
# Interface the ports bind to. 0.0.0.0 exposes MMU to your LAN — if you set
# that, set MMU_API_KEY too.
MMU_BIND=127.0.0.1
MMU_PORT=8765
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687


# ── Access control ─────────────────────────────────────────────────────────
# Shared secret. When set, required on every endpoint except /health.
MMU_API_KEY=

# Browser origins allowed. Empty disables CORS.
MMU_CORS_ORIGINS=


# ── Documents ──────────────────────────────────────────────────────────────
# Host directory mounted read-only at /docs for /ingest.
MMU_DOC_HOST=./documents

# Allow the server to fetch web pages for ingestion.
MMU_WEB_ENABLED=false


# ── Skills ─────────────────────────────────────────────────────────────────
# Let a model create and reverse skills itself. Off by default: crystallizing
# demotes its source memories, and a model that drafts a proposal should not
# also approve it. Reverse anything with POST /skills/{id}/uncrystallize.
MMU_ALLOW_MODEL_CRYSTALLIZE=false


# ── Container names ────────────────────────────────────────────────────────
# Change these to run a second, isolated instance alongside the first.
MMU_NEO4J_NAME=mmu-neo4j
MMU_SERVER_NAME=mmu-memory-server
